# Copy to .env and fill locally. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=27
# json_schema (strict, preferred), json_object, or text, according to provider support.
LLM_RESPONSE_FORMAT=json_schema
# Use omit only for models that disallow temperature; select deterministic mode at provider.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=900
# Groq uses max_completion_tokens; other compatible providers may use max_tokens.
LLM_TOKEN_PARAMETER=max_completion_tokens
# GPT-OSS supports low/medium/high. Use omit for providers that do not accept this field.
LLM_REASONING_EFFORT=low
